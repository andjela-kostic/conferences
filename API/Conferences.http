# Manual requests for the Conferences API — JetBrains HTTP Client (Rider / IntelliJ).
#
# Run the file top to bottom (or "Run all requests"): response handlers (> {% ... %}) store the IDs of created
# resources in variables ({{conferenceId}}, {{topicId}}, {{userId}}, ...) that later requests reuse, so no IDs are hardcoded.
# E-mail addresses are random, so the file can be run repeatedly against the same database.
# The expected status code is in each request name.
#
# @host: http://localhost:5018 for `dotnet run`, http://localhost:8080 for `docker compose up`.

@host = http://localhost:5018

###
# ==========================================
# 0. HEALTH
# ==========================================
# @name Liveness → 200
GET {{host}}/health/live

### Readiness (database reachable) → 200
GET {{host}}/health/ready


###
# ==========================================
# 1. CONFERENCES
# ==========================================
# @name Create conference → 201
POST {{host}}/api/conferences
Content-Type: application/json

{
  "name": "DevConf 2027",
  "description": "Developer conference",
  "date": "2027-06-01T09:00:00Z"
}

> {% client.global.set("conferenceId", response.body.id); %}

### Get all conferences (with topics) → 200
GET {{host}}/api/conferences

### Get conference by ID → 200
GET {{host}}/api/conferences/{{conferenceId}}

### Update conference → 204
PUT {{host}}/api/conferences/{{conferenceId}}
Content-Type: application/json

{
  "name": "DevConf 2027 - Updated",
  "description": "Developer conference, two days",
  "date": "2027-06-02T09:00:00Z"
}

### Get missing conference → 404
GET {{host}}/api/conferences/999999

### Update missing conference → 404
PUT {{host}}/api/conferences/999999
Content-Type: application/json

{
  "name": "Missing",
  "description": "Does not exist",
  "date": "2027-06-01T09:00:00Z"
}

### Create conference with a date that is not UTC → 400
POST {{host}}/api/conferences
Content-Type: application/json

{
  "name": "Local time",
  "description": "Date without a time zone is rejected",
  "date": "2027-06-01T09:00:00"
}

### Create conference with an empty name → 400
POST {{host}}/api/conferences
Content-Type: application/json

{
  "name": "",
  "description": "Name is required",
  "date": "2027-06-01T09:00:00Z"
}


###
# ==========================================
# 2. TOPICS
# ==========================================
# @name Create topic → 201
POST {{host}}/api/topics
Content-Type: application/json

{
  "name": "Microservices Architecture",
  "description": "Building scalable microservices",
  "conferenceId": {{conferenceId}}
}

> {% client.global.set("topicId", response.body.id); %}

### Create second topic → 201
POST {{host}}/api/topics
Content-Type: application/json

{
  "name": "Cloud Native Development",
  "description": "Developing cloud-native applications",
  "conferenceId": {{conferenceId}}
}

> {% client.global.set("secondTopicId", response.body.id); %}

### Get all topics → 200
GET {{host}}/api/topics

### Get topic by ID → 200
GET {{host}}/api/topics/{{topicId}}

### Get topics of a conference → 200
GET {{host}}/api/topics/conference/{{conferenceId}}

### Update topic → 204
PUT {{host}}/api/topics/{{topicId}}
Content-Type: application/json

{
  "name": "Microservices Architecture in .NET 10",
  "description": "Building scalable microservices with ASP.NET Core",
  "conferenceId": {{conferenceId}}
}

### Get missing topic → 404
GET {{host}}/api/topics/999999

### Get topics of a missing conference → 404
GET {{host}}/api/topics/conference/999999

### Create topic in a missing conference → 404
POST {{host}}/api/topics
Content-Type: application/json

{
  "name": "Orphan",
  "description": "The conference does not exist",
  "conferenceId": 999999
}

### Create topic without a conference → 400
POST {{host}}/api/topics
Content-Type: application/json

{
  "name": "No conference",
  "description": "conferenceId must be a positive number",
  "conferenceId": 0
}


###
# ==========================================
# 3. USERS
# ==========================================
# @name Register user → 201
POST {{host}}/api/users
Content-Type: application/json

{
  "firstName": "Ada",
  "lastName": "Lovelace",
  "email": "ada.{{$random.uuid}}@example.com"
}

> {%
    client.global.set("userId", response.body.id);
    client.global.set("userEmail", response.body.email);
    client.global.set("userEmailUpperCase", response.body.email.toUpperCase());
%}

### Register second user → 201
POST {{host}}/api/users
Content-Type: application/json

{
  "firstName": "Grace",
  "lastName": "Hopper",
  "email": "grace.{{$random.uuid}}@example.com"
}

> {% client.global.set("secondUserId", response.body.id); %}

### Get all users → 200
GET {{host}}/api/users

### Get user by ID → 200
GET {{host}}/api/users/{{userId}}

### Update user (keeps own e-mail) → 204
PUT {{host}}/api/users/{{userId}}
Content-Type: application/json

{
  "firstName": "Ada",
  "lastName": "King",
  "email": "{{userEmail}}"
}

### Register with an e-mail already in use (different case) → 409
POST {{host}}/api/users
Content-Type: application/json

{
  "firstName": "Someone",
  "lastName": "Else",
  "email": "{{userEmailUpperCase}}"
}

### Update second user to the first user's e-mail → 409
PUT {{host}}/api/users/{{secondUserId}}
Content-Type: application/json

{
  "firstName": "Grace",
  "lastName": "Hopper",
  "email": "{{userEmail}}"
}

### Register with an invalid e-mail → 400
POST {{host}}/api/users
Content-Type: application/json

{
  "firstName": "No",
  "lastName": "Email",
  "email": "not-an-email"
}

### Get missing user → 404
GET {{host}}/api/users/999999


###
# ==========================================
# 4. TOPIC REGISTRATIONS (many-to-many)
# ==========================================
# @name Register user for topic → 204
POST {{host}}/api/users/register-topic
Content-Type: application/json

{
  "userId": {{userId}},
  "topicId": {{topicId}}
}

### Register user for second topic → 204
POST {{host}}/api/users/register-topic
Content-Type: application/json

{
  "userId": {{userId}},
  "topicId": {{secondTopicId}}
}

### Register for the same topic again → 409
POST {{host}}/api/users/register-topic
Content-Type: application/json

{
  "userId": {{userId}},
  "topicId": {{topicId}}
}

### Register a missing user → 404
POST {{host}}/api/users/register-topic
Content-Type: application/json

{
  "userId": 999999,
  "topicId": {{topicId}}
}

### Register with an invalid user ID → 400
POST {{host}}/api/users/register-topic
Content-Type: application/json

{
  "userId": 0,
  "topicId": {{topicId}}
}

### Topics of the user → 200 (two topics)
GET {{host}}/api/users/{{userId}}/topics

### Users registered for the topic → 200
GET {{host}}/api/users/topic/{{topicId}}

### Topics of a user without registrations → 200 (empty list)
GET {{host}}/api/users/{{secondUserId}}/topics

### Topics of a missing user → 404
GET {{host}}/api/users/999999/topics

### Users of a missing topic → 404
GET {{host}}/api/users/topic/999999

### Unregister user from the second topic → 204
POST {{host}}/api/users/unregister-topic
Content-Type: application/json

{
  "userId": {{userId}},
  "topicId": {{secondTopicId}}
}

### Unregister again (not registered) → 404
POST {{host}}/api/users/unregister-topic
Content-Type: application/json

{
  "userId": {{userId}},
  "topicId": {{secondTopicId}}
}

### Topics of the user → 200 (one topic left)
GET {{host}}/api/users/{{userId}}/topics


###
# ==========================================
# 5. CLEANUP (deletes)
# ==========================================
# @name Delete topic → 204
DELETE {{host}}/api/topics/{{secondTopicId}}

### Delete missing topic → 404
DELETE {{host}}/api/topics/999999

### Delete user (and their registrations) → 204
DELETE {{host}}/api/users/{{userId}}

### Delete second user → 204
DELETE {{host}}/api/users/{{secondUserId}}

### Delete missing user → 404
DELETE {{host}}/api/users/999999

### Delete conference (and its remaining topics) → 204
DELETE {{host}}/api/conferences/{{conferenceId}}

### Delete the same conference again → 404
DELETE {{host}}/api/conferences/{{conferenceId}}

