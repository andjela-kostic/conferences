# Copy to .env (git-ignored) and fill in. Used by docker compose locally.
# In Azure Container Apps these values are Container App secrets, not this file.

POSTGRES_DB=ConferencesDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Host ports (local only). Change them if they are already taken.
POSTGRES_PORT=5432
API_PORT=8080

# For `dotnet run` on the host (outside Docker), keep user-secrets in sync:
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" \
#     "Host=localhost;Port=<POSTGRES_PORT>;Database=<POSTGRES_DB>;Username=<POSTGRES_USER>;Password=<POSTGRES_PASSWORD>" --project API

